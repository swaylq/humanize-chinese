  "inference": {
    "formula": "score = bias + sum(weights[i] * (x[i] - means[i]) / stds[i])",
    "probability": "p_ai = 1 / (1 + exp(-score))",
    "score_0_100": "vipu_score = p_ai * 100",
    "python_example": "\nimport json, math\nwith open('logistic_ai_classifier.json') as f:\n    m = json.load(f)\ndef classify(features):\n    score = m['bias']\n    for i, name in enumerate(m['feature_names']):\n        x = features.get(name, 0.0)\n        if m['stds'][i] > 1e-10:\n            score += m['weights'][i] * (x - m['means'][i]) / m['stds'][i]\n    p_ai = 1 / (1 + math.exp(-score))\n    return {'p_ai': p_ai, 'score_0_100': p_ai * 100}\n"
